<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fograin.Windows.Features.Home.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Fograin.Windows.Models"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid Padding="32,24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Page header: title, live subtitle and the instance actions. -->
            <Grid Height="56">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Bottom" Spacing="2">
                    <TextBlock Text="主页" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind Model.HomeSubtitle, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Bottom">
                    <Button
                        Style="{StaticResource AccentButtonStyle}"
                        Height="32"
                        Padding="12,0"
                        FontSize="13"
                        Click="AddInstance_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Viewbox Width="14" Height="14">
                                <SymbolIcon
                                    Symbol="Add"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Viewbox>
                            <TextBlock
                                Text="添加实例"
                                FontSize="13"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Style="{StaticResource FograinSubtleCommandButtonStyle}"
                        Click="ImportDirectory_Click"
                        ToolTipService.ToolTip="登记一个已有的 .minecraft 目录">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Viewbox Width="14" Height="14">
                                <SymbolIcon Symbol="Upload" />
                            </Viewbox>
                            <TextBlock Text="导入 .minecraft" FontSize="13" />
                        </StackPanel>
                    </Button>
                    <Button
                        Style="{StaticResource FograinIconButtonStyle}"
                        Click="Refresh_Click"
                        ToolTipService.ToolTip="刷新">
                        <Viewbox Width="14" Height="14">
                            <SymbolIcon Symbol="Refresh" />
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <!-- Main column: current instance hero plus the instance list. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18">
                        <!-- Hero for the current instance. -->
                        <Border
                            Height="300"
                            CornerRadius="12"
                            Visibility="{x:Bind Model.HeroVisibility, Mode=OneWay}">
                            <Grid>
                                <Image Source="ms-appx:///Assets/hero-forest.jpg" Stretch="UniformToFill" />
                                <Border Background="{StaticResource FograinHeroScrimBrush}" />

                                <StackPanel
                                    VerticalAlignment="Bottom"
                                    Padding="24,0,24,20"
                                    Spacing="10">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Width="56"
                                            Height="56"
                                            CornerRadius="8"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                            <Viewbox Width="26" Height="26">
                                                <SymbolIcon
                                                    Symbol="{x:Bind Model.CurrentInstanceIcon, Mode=OneWay}"
                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            </Viewbox>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock
                                                Text="{x:Bind Model.CurrentInstanceName, Mode=OneWay}"
                                                FontSize="22"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{x:Bind Model.CurrentInstanceMeta, Mode=OneWay}"
                                                FontSize="12"
                                                Foreground="#CCFFFFFF"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            Style="{StaticResource AccentButtonStyle}"
                                            Height="32"
                                            Padding="14,0"
                                            IsEnabled="{x:Bind Model.CanStartGame, Mode=OneWay}"
                                            Click="StartCurrent_Click"
                                            ToolTipService.ToolTip="启动当前实例">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Viewbox Width="13" Height="13">
                                                    <SymbolIcon
                                                        Symbol="Play"
                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                </Viewbox>
                                                <TextBlock
                                                    Text="开始游戏"
                                                    FontSize="13"
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            Style="{StaticResource FograinSmallButtonStyle}"
                                            Height="32"
                                            IsEnabled="{x:Bind Model.CanStopGame, Mode=OneWay}"
                                            Click="StopCurrent_Click"
                                            ToolTipService.ToolTip="停止游戏进程">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Viewbox Width="12" Height="12">
                                                    <SymbolIcon Symbol="Stop" />
                                                </Viewbox>
                                                <TextBlock Text="停止" FontSize="13" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            Style="{StaticResource FograinSmallButtonStyle}"
                                            Height="32"
                                            Click="SettingsCurrent_Click"
                                            ToolTipService.ToolTip="游戏设置">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Viewbox Width="12" Height="12">
                                                    <SymbolIcon Symbol="Setting" />
                                                </Viewbox>
                                                <TextBlock Text="游戏设置" FontSize="13" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            Style="{StaticResource FograinIconButtonStyle}"
                                            Height="32"
                                            Width="32"
                                            Click="FolderCurrent_Click"
                                            ToolTipService.ToolTip="打开实例目录">
                                            <Viewbox Width="13" Height="13">
                                                <SymbolIcon Symbol="Folder" />
                                            </Viewbox>
                                        </Button>

                                        <ProgressRing
                                            Width="18"
                                            Height="18"
                                            IsActive="True"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind Model.LaunchingVisibility, Mode=OneWay}" />
                                    </StackPanel>

                                    <TextBlock
                                        Text="{x:Bind Model.CurrentInstanceStatusText, Mode=OneWay}"
                                        FontSize="11.5"
                                        Foreground="#CCFFFFFF" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Empty state before the first instance exists. -->
                        <Border
                            Style="{StaticResource FograinCardStyle}"
                            Padding="28"
                            MinHeight="240"
                            Visibility="{x:Bind Model.EmptyHeroVisibility, Mode=OneWay}">
                            <StackPanel VerticalAlignment="Center" Spacing="10">
                                <TextBlock Text="还没有实例" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock
                                    Text="通过下载页选择 Minecraft 版本、加载器并安装，几分钟后就能开始游戏。"
                                    Style="{StaticResource FograinMutedTextStyle}"
                                    TextWrapping="Wrap"
                                    MaxWidth="460"
                                    HorizontalAlignment="Left" />
                                <Button
                                    Style="{StaticResource AccentButtonStyle}"
                                    Height="34"
                                    Padding="16,0"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Left"
                                    Click="AddInstance_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Viewbox Width="13" Height="13">
                                            <SymbolIcon
                                                Symbol="Add"
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Viewbox>
                                        <TextBlock
                                            Text="添加实例"
                                            FontSize="13"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Instance list with the macOS 最近/收藏/全部 filter. -->
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Height="34">
                                <TextBlock
                                    Text="实例"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    VerticalAlignment="Center" />

                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                                    <SelectorBar
                                        x:Name="HomeFilterBar"
                                        Height="32"
                                        FontSize="13"
                                        SelectionChanged="HomeFilter_SelectionChanged">
                                        <SelectorBarItem x:Name="RecentFilterItem" Text="最近" IsSelected="True" />
                                        <SelectorBarItem x:Name="FavoritesFilterItem" Text="收藏" />
                                        <SelectorBarItem x:Name="AllFilterItem" Text="全部" />
                                    </SelectorBar>

                                    <ToggleButton
                                        x:Name="ListLayoutButton"
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        CornerRadius="4"
                                        IsChecked="True"
                                        Click="ListLayout_Click"
                                        ToolTipService.ToolTip="列表视图">
                                        <Viewbox Width="13" Height="13">
                                            <SymbolIcon Symbol="List" />
                                        </Viewbox>
                                    </ToggleButton>
                                    <ToggleButton
                                        x:Name="GridLayoutButton"
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        CornerRadius="4"
                                        Click="GridLayout_Click"
                                        ToolTipService.ToolTip="网格视图">
                                        <Viewbox Width="13" Height="13">
                                            <SymbolIcon Symbol="AllApps" />
                                        </Viewbox>
                                    </ToggleButton>
                                </StackPanel>
                            </Grid>

                            <ListView
                                x:Name="RecentList"
                                Grid.Row="1"
                                ItemsSource="{x:Bind Model.HomeInstances}"
                                SelectionMode="Single"
                                ItemContainerStyle="{StaticResource FograinHomeRowStyle}"
                                SelectionChanged="HomeList_SelectionChanged"
                                DoubleTapped="HomeList_DoubleTapped"
                                Visibility="{x:Bind Model.ListVisibility, Mode=OneWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:InstanceRow">
                                        <Grid Height="54" Padding="12,0" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border
                                                Width="32"
                                                Height="32"
                                                CornerRadius="4"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                <Viewbox Width="16" Height="16">
                                                    <SymbolIcon
                                                        Symbol="{x:Bind Icon}"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Viewbox>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <TextBlock Text="{x:Bind Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                    <FontIcon
                                                        Glyph="&#xE735;"
                                                        FontSize="9"
                                                        VerticalAlignment="Center"
                                                        Visibility="{x:Bind FavoriteVisibility}"
                                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Text="{x:Bind Detail}"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{x:Bind LastPlayedText}"
                                                FontSize="12"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                            <Button
                                                Grid.Column="3"
                                                Style="{StaticResource FograinIconButtonStyle}"
                                                Width="28"
                                                Height="28"
                                                ToolTipService.ToolTip="更多操作">
                                                <SymbolIcon Symbol="More" />
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem
                                                            Text="开始游戏"
                                                            Tag="{x:Bind Id}"
                                                            Click="RowPlay_Click" />
                                                        <MenuFlyoutItem
                                                            Text="在实例库中显示"
                                                            Tag="{x:Bind Id}"
                                                            Click="RowOpenLibrary_Click" />
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem
                                                            Text="打开实例文件夹"
                                                            Tag="{x:Bind Id}"
                                                            Click="RowOpenFolder_Click" />
                                                        <MenuFlyoutItem
                                                            Text="{x:Bind FavoriteActionText}"
                                                            Tag="{x:Bind Id}"
                                                            Click="RowToggleFavorite_Click" />
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <GridView
                                x:Name="RecentGrid"
                                Grid.Row="1"
                                ItemsSource="{x:Bind Model.HomeInstances}"
                                SelectionMode="Single"
                                ItemContainerStyle="{StaticResource FograinCardItemStyle}"
                                SelectionChanged="HomeGrid_SelectionChanged"
                                DoubleTapped="HomeList_DoubleTapped"
                                Visibility="{x:Bind Model.GridVisibility, Mode=OneWay}">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid
                                            Orientation="Horizontal"
                                            ItemWidth="284"
                                            ItemHeight="88" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="models:InstanceRow">
                                        <Border Style="{StaticResource FograinCardStyle}" Padding="14,12">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border
                                                    Width="36"
                                                    Height="36"
                                                    CornerRadius="6"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                    <Viewbox Width="18" Height="18">
                                                        <SymbolIcon
                                                            Symbol="{x:Bind Icon}"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Viewbox>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <TextBlock Text="{x:Bind Name}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                                        <FontIcon
                                                            Glyph="&#xE735;"
                                                            FontSize="9"
                                                            VerticalAlignment="Center"
                                                            Visibility="{x:Bind FavoriteVisibility}"
                                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Text="{x:Bind DisplayVersion}"
                                                        FontSize="11.5"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <TextBlock
                                                    Grid.Column="2"
                                                    Text="{x:Bind LastPlayedText}"
                                                    FontSize="11.5"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right rail: queue, runtime and release headlines (macOS status column). -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <Border Style="{StaticResource FograinCardStyle}" Padding="16">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                                        <SymbolIcon
                                            Symbol="Download"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Viewbox>
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="任务队列"
                                        Style="{StaticResource FograinSectionTitleStyle}"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{x:Bind Model.DownloadsSpeedText, Mode=OneWay}"
                                        FontSize="11.5"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>

                                <TextBlock
                                    Text="没有进行中的任务"
                                    Style="{StaticResource FograinTinyTextStyle}"
                                    Visibility="{x:Bind Model.EmptyQueueVisibility, Mode=OneWay}" />

                                <ItemsControl
                                    ItemsSource="{x:Bind Model.ActiveTasks}"
                                    Visibility="{x:Bind Model.QueueVisibility, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="10" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:TaskRow">
                                            <StackPanel Spacing="5">
                                                <Grid ColumnSpacing="8">
                                                    <TextBlock
                                                        Text="{x:Bind Title}"
                                                        FontSize="12"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Text="{x:Bind StateText}"
                                                        FontSize="11"
                                                        HorizontalAlignment="Right"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </Grid>
                                                <ProgressBar
                                                    Minimum="0"
                                                    Maximum="100"
                                                    Value="{x:Bind Percent}"
                                                    Height="3" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource FograinCardStyle}" Padding="16">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                                        <SymbolIcon
                                            Symbol="Repair"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Viewbox>
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="运行环境"
                                        Style="{StaticResource FograinSectionTitleStyle}"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <Grid ColumnSpacing="10" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Text="Java"
                                        Style="{StaticResource FograinKeyTextStyle}"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind Model.JavaSummary, Mode=OneWay}"
                                        Style="{StaticResource FograinValueTextStyle}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                    <Viewbox Grid.Column="2" Width="12" Height="12" VerticalAlignment="Center">
                                        <SymbolIcon
                                            Symbol="Accept"
                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    </Viewbox>

                                    <TextBlock
                                        Grid.Row="1"
                                        Text="内存分配"
                                        Style="{StaticResource FograinKeyTextStyle}"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="{x:Bind Model.MemorySummary, Mode=OneWay}"
                                        Style="{StaticResource FograinValueTextStyle}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Text="渲染"
                                        Style="{StaticResource FograinKeyTextStyle}"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Text="{x:Bind Model.RenderSummary}"
                                        Style="{StaticResource FograinValueTextStyle}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource FograinCardStyle}" Padding="16">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                                        <SymbolIcon
                                            Symbol="Page"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Viewbox>
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="版本动态"
                                        Style="{StaticResource FograinSectionTitleStyle}"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock
                                    Text="暂时无法读取版本动态"
                                    Style="{StaticResource FograinTinyTextStyle}"
                                    Visibility="{x:Bind Model.NewsEmptyVisibility, Mode=OneWay}" />

                                <ItemsControl
                                    ItemsSource="{x:Bind Model.News}"
                                    Visibility="{x:Bind Model.NewsVisibility, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="10" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:NewsItem">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{x:Bind Headline}"
                                                        FontSize="12.5"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Text="{x:Bind Detail}"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="1"
                                                    Content="安装"
                                                    Style="{StaticResource FograinSmallButtonStyle}"
                                                    VerticalAlignment="Center"
                                                    Tag="{x:Bind VersionId}"
                                                    Click="NewsInstall_Click" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- First paint overlay while instances are being read from the core. -->
        <Grid
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            Opacity="0.92"
            Visibility="{x:Bind Model.LoadingVisibility, Mode=OneWay}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressRing Width="24" Height="24" IsActive="True" />
                <TextBlock Text="正在读取实例…" Style="{StaticResource FograinMutedTextStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
