    "gnome": {
      "window": 12,
      "control": 6,
      "pill": 18,
      "card": 12,
      "icon": 8
    },
    "android": {
      "window": 16,
      "control": 12,
      "pill": 20,
      "card": 16,
      "icon": 12
    }
