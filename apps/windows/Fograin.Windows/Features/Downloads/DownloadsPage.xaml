<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fograin.Windows.Features.Downloads.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Fograin.Windows.Models"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: category switcher + channel/loader filter, like the macOS
             titlebar pickers for 下载. -->
        <Grid Height="56">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Bottom" Spacing="2" Margin="0,0,20,0">
                <TextBlock Text="下载" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="浏览与安装"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <SelectorBar
                x:Name="CategoryBar"
                Grid.Column="1"
                Height="32"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Left"
                FontSize="13"
                SelectionChanged="CategoryBar_SelectionChanged">
                <SelectorBarItem x:Name="GameCategoryItem" Text="游戏" IsSelected="True" />
                <SelectorBarItem x:Name="ModCategoryItem" Text="模组" />
                <SelectorBarItem x:Name="ModpackCategoryItem" Text="整合包" />
                <SelectorBarItem x:Name="ResourcepackCategoryItem" Text="资源包" />
                <SelectorBarItem x:Name="ShaderpackCategoryItem" Text="光影" />
                <SelectorBarItem x:Name="DatapackCategoryItem" Text="数据包" />
            </SelectorBar>

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Bottom">
                <ComboBox
                    x:Name="ChannelComboBox"
                    Width="112"
                    Height="32"
                    SelectedIndex="0"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind Model.ChannelVisibility, Mode=OneWay}"
                    ToolTipService.ToolTip="版本类型"
                    SelectionChanged="ChannelComboBox_SelectionChanged">
                    <ComboBoxItem Content="正式版" />
                    <ComboBoxItem Content="快照" />
                    <ComboBoxItem Content="愚人节" />
                    <ComboBoxItem Content="远古版本" />
                </ComboBox>
                <ComboBox
                    x:Name="LoaderComboBox"
                    Width="132"
                    Height="32"
                    SelectedIndex="0"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind Model.LoaderFilterVisibility, Mode=OneWay}"
                    ToolTipService.ToolTip="加载器"
                    SelectionChanged="LoaderComboBox_SelectionChanged">
                    <ComboBoxItem Content="全部加载器" />
                    <ComboBoxItem Content="Forge" />
                    <ComboBoxItem Content="NeoForge" />
                    <ComboBoxItem Content="Fabric" />
                    <ComboBoxItem Content="Quilt" />
                    <ComboBoxItem Content="OptiFine" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="VersionColumn" Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Version pane: search + native ListView. -->
            <Grid Visibility="{x:Bind Model.GameCategoryVisibility, Mode=OneWay}" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="VersionSearchBox"
                        Height="32"
                        PlaceholderText="搜索版本"
                        VerticalAlignment="Center"
                        TextChanged="VersionSearchBox_TextChanged" />
                    <Button
                        Grid.Column="1"
                        Style="{StaticResource FograinIconButtonStyle}"
                        Height="32"
                        Width="32"
                        Click="RefreshVersions_Click"
                        ToolTipService.ToolTip="重新读取版本清单">
                        <Viewbox Width="13" Height="13">
                            <SymbolIcon Symbol="Refresh" />
                        </Viewbox>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <ListView
                        x:Name="VersionList"
                        SelectionMode="Single"
                        ItemContainerStyle="{StaticResource FograinVersionRowStyle}"
                        SelectionChanged="VersionList_SelectionChanged"
                        Visibility="{x:Bind Model.VersionListVisibility, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:VersionEntry">
                                <Grid Height="36" Padding="10,0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                                        <SymbolIcon
                                            Symbol="AllApps"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </Viewbox>
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind Id}"
                                        FontSize="13"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{x:Bind ReleasedText}"
                                        FontSize="11"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,16,0,0"
                        Spacing="8"
                        Visibility="{x:Bind Model.VersionLoadingVisibility, Mode=OneWay}">
                        <ProgressRing Width="20" Height="20" IsActive="True" HorizontalAlignment="Center" />
                        <TextBlock
                            Text="版本清单加载中…"
                            Style="{StaticResource FograinTinyTextStyle}"
                            HorizontalAlignment="Center" />
                    </StackPanel>

                    <TextBlock
                        Text="{x:Bind Model.DownloadVersionsError, Mode=OneWay}"
                        Margin="2,12,2,0"
                        FontSize="12"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind Model.VersionErrorVisibility, Mode=OneWay}" />

                    <TextBlock
                        Text="{x:Bind Model.VersionEmptyMessage, Mode=OneWay}"
                        Margin="2,12,2,0"
                        Style="{StaticResource FograinTinyTextStyle}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind Model.VersionEmptyVisibility, Mode=OneWay}" />
                </Grid>
            </Grid>

            <!-- Detail pane: plan preview + 安装; categories owned by M8/M9 show
                 their milestone instead of an empty list. -->
            <Grid Grid.Column="1">
                <ScrollViewer Visibility="{x:Bind Model.GameCategoryVisibility, Mode=OneWay}">
                    <StackPanel>
                        <StackPanel Spacing="14" Visibility="{x:Bind Model.DetailVisibility, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock
                                    Text="{x:Bind Model.SelectedVersionTitle, Mode=OneWay}"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />
                                <Border
                                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                    CornerRadius="8"
                                    Padding="8,3"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{x:Bind Model.SelectedVersionKindText, Mode=OneWay}"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                            </StackPanel>

                            <Grid ColumnSpacing="12" RowSpacing="8" MaxWidth="420" HorizontalAlignment="Left">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="需要 Java" Style="{StaticResource FograinKeyTextStyle}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind Model.PlanJavaText, Mode=OneWay}"
                                    Style="{StaticResource FograinValueTextStyle}" />

                                <TextBlock Grid.Row="1" Text="文件" Style="{StaticResource FograinKeyTextStyle}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{x:Bind Model.PlanFilesText, Mode=OneWay}"
                                    Style="{StaticResource FograinValueTextStyle}" />

                                <TextBlock Grid.Row="2" Text="体积" Style="{StaticResource FograinKeyTextStyle}" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Text="{x:Bind Model.PlanSizeText, Mode=OneWay}"
                                    Style="{StaticResource FograinValueTextStyle}" />

                                <TextBlock Grid.Row="3" Text="发布" Style="{StaticResource FograinKeyTextStyle}" />
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Text="{x:Bind Model.SelectedVersionReleasedText, Mode=OneWay}"
                                    Style="{StaticResource FograinValueTextStyle}" />
                            </Grid>

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8"
                                Visibility="{x:Bind Model.PlanLoadingVisibility, Mode=OneWay}">
                                <ProgressRing Width="16" Height="16" IsActive="True" />
                                <TextBlock
                                    Text="正在计算安装内容…"
                                    Style="{StaticResource FograinTinyTextStyle}"
                                    VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock
                                Text="{x:Bind Model.PlanErrorText, Mode=OneWay}"
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind Model.PlanErrorVisibility, Mode=OneWay}" />

                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                <Button
                                    Style="{StaticResource AccentButtonStyle}"
                                    Height="36"
                                    Padding="18,0"
                                    IsEnabled="{x:Bind Model.CanInstall, Mode=OneWay}"
                                    Click="Install_Click"
                                    ToolTipService.ToolTip="开始下载并安装">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Viewbox Width="14" Height="14">
                                            <SymbolIcon
                                                Symbol="Download"
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Viewbox>
                                        <TextBlock
                                            Text="安装"
                                            FontSize="13"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </Button>

                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind Model.DownloadRunningVisibility, Mode=OneWay}">
                                    <ProgressRing Width="16" Height="16" IsActive="True" />
                                    <TextBlock
                                        Text="任务进行中…可在右侧队列查看进度"
                                        Style="{StaticResource FograinTinyTextStyle}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock
                                Text="内存、JVM 参数与显示选项在下载完成后的「游戏设置」里调整。"
                                Style="{StaticResource FograinTinyTextStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,96,0,0"
                            Spacing="8"
                            Visibility="{x:Bind Model.NoDetailVisibility, Mode=OneWay}">
                            <Viewbox Width="36" Height="36" HorizontalAlignment="Center">
                                <SymbolIcon
                                    Symbol="AllApps"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Viewbox>
                            <TextBlock
                                Text="选择一个版本"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                HorizontalAlignment="Center" />
                            <TextBlock
                                Text="在左侧选择一个 Minecraft 版本后即可安装。"
                                Style="{StaticResource FograinMutedTextStyle}"
                                HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Visibility="{x:Bind Model.ComingSoonVisibility, Mode=OneWay}">
                    <Viewbox Width="40" Height="40" HorizontalAlignment="Center">
                        <SymbolIcon
                            Symbol="{x:Bind Model.ComingSoonIcon, Mode=OneWay}"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Viewbox>
                    <TextBlock
                        Text="{x:Bind Model.ComingSoonTitle, Mode=OneWay}"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="{x:Bind Model.ComingSoonDescription, Mode=OneWay}"
                        Style="{StaticResource FograinMutedTextStyle}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        MaxWidth="440"
                        HorizontalAlignment="Center" />
                    <Border
                        Margin="0,4,0,0"
                        Padding="12,5"
                        CornerRadius="10"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource AccentFillColorSecondaryBrush}">
                        <TextBlock
                            Text="{x:Bind Model.ComingSoonMilestone, Mode=OneWay}"
                            FontSize="11"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Queue column: active tasks, aggregate speed and history hint. -->
            <Border
                Grid.Column="2"
                Style="{StaticResource FograinCardStyle}"
                Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                            <SymbolIcon
                                Symbol="Download"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Viewbox>
                        <TextBlock
                            Grid.Column="1"
                            Text="任务队列"
                            Style="{StaticResource FograinSectionTitleStyle}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Grid.Column="2"
                            Text="{x:Bind Model.DownloadsSpeedText, Mode=OneWay}"
                            FontSize="11.5"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <TextBlock
                                Text="没有进行中的任务"
                                Style="{StaticResource FograinTinyTextStyle}"
                                Visibility="{x:Bind Model.EmptyQueueVisibility, Mode=OneWay}" />

                            <ItemsControl
                                ItemsSource="{x:Bind Model.ActiveTasks}"
                                Visibility="{x:Bind Model.QueueVisibility, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="12" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:TaskRow">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Text="{x:Bind Title}"
                                                    FontSize="12"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{x:Bind StateText}"
                                                    FontSize="11"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <Button
                                                    Grid.Column="2"
                                                    Style="{StaticResource FograinIconButtonStyle}"
                                                    Width="24"
                                                    Height="24"
                                                    Tag="{x:Bind Id}"
                                                    Click="CancelTask_Click"
                                                    ToolTipService.ToolTip="取消任务">
                                                    <Viewbox Width="12" Height="12">
                                                        <SymbolIcon Symbol="Cancel" />
                                                    </Viewbox>
                                                </Button>
                                            </Grid>
                                            <ProgressBar
                                                Minimum="0"
                                                Maximum="100"
                                                Value="{x:Bind Percent}"
                                                Height="3" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Spacing="6">
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <TextBlock Text="最近完成" Style="{StaticResource FograinMutedTextStyle}" FontWeight="SemiBold" />
                        <TextBlock
                            Text="完成的安装会进入实例库，并可继续在「游戏设置」里调整内存与显示选项。"
                            Style="{StaticResource FograinTinyTextStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
