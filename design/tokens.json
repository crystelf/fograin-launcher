{
  "$schema": "https://fograin.dev/schemas/design-tokens-v1.json",
  "meta": {
    "name": "Fograin Launcher",
    "source": "fograin.pen",
    "version": 1,
    "note": "Single source of truth for native UI colors. Desktop light values are provisional until the pen file has light screens."
  },
  "typography": {
    "macos": [
      "SF Pro Text",
      "SF Pro Display",
      "PingFang SC",
      "sans-serif"
    ],
    "windows": [
      "Segoe UI Variable",
      "Microsoft YaHei UI",
      "sans-serif"
    ],
    "gnome": [
      "Adwaita Sans",
      "Noto Sans CJK SC",
      "sans-serif"
    ],
    "android": [
      "Roboto",
      "Noto Sans CJK SC",
      "sans-serif"
    ],
    "mono": [
      "SF Mono",
      "Cascadia Code",
      "JetBrains Mono",
      "monospace"
    ],
    "sizes": {
      "caption": 11,
      "small": 12,
      "body": 13,
      "subhead": 15,
      "heading": 17,
      "title": 22,
      "page": 28,
      "hero": 32
    }
  },
  "spacing": {
    "1": 2,
    "2": 4,
    "3": 6,
    "4": 8,
    "5": 10,
    "6": 12,
    "7": 14,
    "8": 16,
    "9": 20,
    "10": 24,
    "11": 32
