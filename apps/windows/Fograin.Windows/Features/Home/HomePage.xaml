<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fograin.Windows.Features.Home.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Fograin.Windows.Models"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="36,28" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header: title, caption and native command buttons. -->
        <Grid Height="60">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Bottom" Spacing="2">
                <TextBlock Text="主页" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="{x:Bind ViewModel.PageCaption}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="4"
                VerticalAlignment="Bottom">
                <Button Style="{StaticResource FograinSubtleCommandButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Add" FontSize="14" />
                        <TextBlock Text="新建实例" FontSize="13" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FograinSubtleCommandButtonStyle}" Click="ImportPackage_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Upload" FontSize="14" />
                        <TextBlock Text="导入整合包" FontSize="13" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FograinSubtleCommandButtonStyle}" Click="GameDirectory_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Folder" FontSize="14" />
                        <TextBlock Text="游戏目录" FontSize="13" />
                    </StackPanel>
                </Button>
                <Rectangle
                    Width="1"
                    Height="20"
                    Margin="8,0"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                    VerticalAlignment="Center" />
                <Button Style="{StaticResource FograinIconButtonStyle}" ToolTipService.ToolTip="更多">
                    <SymbolIcon Symbol="More" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Grid RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="340" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Current instance hero: image, launch bar and native controls. -->
                <Border Style="{StaticResource FograinCardStyle}" Height="340">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="244" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Image Source="ms-appx:///Assets/hero-forest.jpg" Stretch="UniformToFill" />
                            <Border
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="16"
                                Padding="10,4"
                                CornerRadius="4"
                                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <SymbolIcon
                                        Symbol="Accept"
                                        FontSize="12"
                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    <TextBlock Text="已就绪 · 资源校验完成" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border
                            Grid.Row="1"
                            Padding="20,0"
                            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Width="56"
                                    Height="56"
                                    CornerRadius="6"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                    <Image Source="ms-appx:///Assets/instance-fog.png" Stretch="UniformToFill" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.Current.Name}"
                                        Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <FontIcon
                                                Glyph="&#xE943;"
                                                FontSize="14"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.Current.JavaLabel}"
                                                FontSize="12"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <SymbolIcon
                                                Symbol="AllApps"
                                                FontSize="14"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.Current.LoaderLabel}"
                                                FontSize="12"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <SymbolIcon
                                                Symbol="Library"
                                                FontSize="14"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.Current.ModsLabel}"
                                                FontSize="12"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <ComboBox
                                    Grid.Column="2"
                                    Width="124"
                                    Height="32"
                                    SelectedIndex="0"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="启动配置">
                                    <ComboBoxItem Content="默认配置" />
                                    <ComboBoxItem Content="高性能" />
                                    <ComboBoxItem Content="省电" />
                                </ComboBox>

                                <Button
                                    Grid.Column="3"
                                    Style="{StaticResource FograinIconButtonStyle}"
                                    Width="40"
                                    Height="40"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    ToolTipService.ToolTip="实例设置">
                                    <SymbolIcon Symbol="Setting" FontSize="16" />
                                </Button>

                                <Button
                                    Grid.Column="4"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Width="148"
                                    Height="40"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="启动当前实例">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon
                                            Symbol="Play"
                                            FontSize="16"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        <TextBlock
                                            Text="开始游戏"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Recent instances: native ListView with selector tabs. -->
                <Grid Grid.Row="1" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Height="33">
                        <TextBlock
                            Text="实例"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            VerticalAlignment="Center" />
                        <SelectorBar
                            Height="32"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="13">
                            <SelectorBarItem Text="最近" IsSelected="True" />
                            <SelectorBarItem Text="收藏" />
                            <SelectorBarItem Text="全部" />
                        </SelectorBar>
                    </Grid>

                    <ListView
                        x:Name="RecentList"
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Recent}"
                        SelectionMode="Single"
                        ItemContainerStyle="{StaticResource FograinHomeRowStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Instance">
                                <Grid Height="54" Padding="12,0,16,0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Width="32"
                                        Height="32"
                                        CornerRadius="4"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        VerticalAlignment="Center">
                                        <SymbolIcon
                                            Symbol="{x:Bind Icon}"
                                            FontSize="16"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontSize="14" />
                                        <TextBlock
                                            Text="{x:Bind Detail}"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{x:Bind LastPlayedText}"
                                        FontSize="12"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    <Button
                                        Grid.Column="3"
                                        Style="{StaticResource FograinIconButtonStyle}"
                                        ToolTipService.ToolTip="开始游戏">
                                        <SymbolIcon Symbol="Play" FontSize="14" />
                                    </Button>

                                    <Button
                                        Grid.Column="4"
                                        Style="{StaticResource FograinIconButtonStyle}"
                                        ToolTipService.ToolTip="更多">
                                        <SymbolIcon Symbol="More" FontSize="14" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>

            <!-- Secondary rail: downloads, runtime, news and the current account. -->
            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource FograinCardStyle}" Padding="16">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon
                                Symbol="Download"
                                FontSize="16"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                Grid.Column="1"
                                Text="下载队列"
                                FontSize="14"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="2"
                                Text="18.4 MB/s"
                                FontSize="12"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.Downloads}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:DownloadTask">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnSpacing="8">
                                            <TextBlock Text="{x:Bind Name}" FontSize="12" />
                                            <TextBlock
                                                Text="{x:Bind ProgressText}"
                                                FontSize="12"
                                                HorizontalAlignment="Right"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                        <ProgressBar
                                            Minimum="0"
                                            Maximum="100"
                                            Value="{x:Bind Percent}"
                                            Height="3" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource FograinCardStyle}" Padding="16">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon
                                Symbol="Repair"
                                FontSize="16"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                Grid.Column="1"
                                Text="运行环境"
                                FontSize="14"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center" />
                        </Grid>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.Runtime}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:RuntimeRow">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Text="{x:Bind Key}"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind Value}"
                                            FontSize="12"
                                            HorizontalAlignment="Right" />
                                        <SymbolIcon
                                            Grid.Column="2"
                                            Symbol="Accept"
                                            FontSize="12"
                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource FograinCardStyle}" Padding="16">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon
                                Symbol="Page"
                                FontSize="16"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                Grid.Column="1"
                                Text="版本动态"
                                FontSize="14"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center" />
                        </Grid>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.News}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:NewsItem">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Headline}" FontSize="13" />
                                            <TextBlock
                                                Text="{x:Bind Detail}"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Content="安装"
                                            Style="{StaticResource FograinSmallButtonStyle}"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource FograinCardStyle}" Padding="12,10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PersonPicture
                            Initials="{x:Bind ViewModel.Account.Initials}"
                            Width="32"
                            Height="32" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.Account.Name}" FontSize="13" />
                            <TextBlock
                                Text="{x:Bind ViewModel.Account.Kind}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <FontIcon
                            Grid.Column="2"
                            Glyph="&#xE76C;"
                            FontSize="14"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
