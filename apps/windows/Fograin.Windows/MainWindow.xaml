<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Fograin.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="雾雨启动器">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The native WinUI TitleBar control supplies the caption buttons, drag
             regions and pane toggle. The search box is native and follows the
             current section (主页 / 实例库), like the macOS toolbar search. -->
        <TitleBar
            x:Name="AppTitleBar"
            Height="48"
            Title="雾雨启动器"
            Subtitle="主页"
            IsBackButtonVisible="True"
            IsPaneToggleButtonVisible="False"
            BackRequested="AppTitleBar_BackRequested">
            <TitleBar.IconSource>
                <ImageIconSource>
                    <ImageIconSource.ImageSource>
                        <BitmapImage UriSource="ms-appx:///Assets/app-icon.png" />
                    </ImageIconSource.ImageSource>
                </ImageIconSource>
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox
                    x:Name="TitleBarSearchBox"
                    MinWidth="280"
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    PlaceholderText="搜索实例、模组…"
                    QueryIcon="Find"
                    Visibility="Collapsed"
                    TextChanged="TitleBarSearchBox_TextChanged"
                    QuerySubmitted="TitleBarSearchBox_QuerySubmitted" />
            </TitleBar.Content>
        </TitleBar>

        <Grid Grid.Row="1">
            <NavigationView
                x:Name="RootNavigation"
                PaneDisplayMode="Left"
                IsPaneOpen="True"
                OpenPaneLength="256"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="True"
                IsSettingsVisible="False"
                IsTitleBarAutoPaddingEnabled="False"
                SelectionChanged="RootNavigation_SelectionChanged">

                <NavigationView.MenuItems>
                    <NavigationViewItem x:Name="HomeItem" Content="主页" Tag="home">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Home" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="LibraryItem" Content="实例库" Tag="library">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Library" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="服务器" Tag="servers">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Globe" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItemHeader Content="资源" />
                    <NavigationViewItem x:Name="DownloadsItem" Content="下载" Tag="downloads">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Download" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Java 运行时" Tag="java">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE943;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <NavigationView.FooterMenuItems>
                    <NavigationViewItem Content="账户" Tag="accounts">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Contact" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="设置" Tag="settings">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Setting" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.FooterMenuItems>

                <Frame x:Name="RootFrame" />
            </NavigationView>

            <!-- Transient status capsule (macOS notice overlay): queue, session
                 and import feedback that must not block the page. -->
            <InfoBar
                x:Name="NoticeBar"
                IsOpen="False"
                IsClosable="True"
                MaxWidth="640"
                Margin="16,12"
                HorizontalAlignment="Center"
                VerticalAlignment="Top" />
        </Grid>
    </Grid>
</Window>
