<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Fograin.Windows.Features.Instances.InstanceSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Fograin.Windows.Models"
    mc:Ignorable="d"
    Title="游戏设置"
    CloseButtonText="关闭"
    DefaultButton="Close">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">700</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
    </ContentDialog.Resources>

    <Grid MinWidth="620">
        <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <!-- Header: loader tile, name and what this page owns. -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="40"
                        Height="40"
                        CornerRadius="8"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Viewbox Width="20" Height="20">
                            <SymbolIcon
                                x:Name="HeaderTileIcon"
                                Symbol="AllApps"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Viewbox>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock x:Name="HeaderNameText" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="HeaderSubtitleText"
                            Style="{StaticResource FograinTinyTextStyle}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource FograinCardStyle}" Padding="12">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="OverviewVersionText" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="OverviewDetailText" Style="{StaticResource FograinTinyTextStyle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <InfoBar
                    x:Name="ErrorBar"
                    IsOpen="False"
                    IsClosable="False"
                    Severity="Error" />

                <!-- 启动 -->
                <StackPanel Spacing="10">
                    <TextBlock Text="启动" Style="{StaticResource FograinSectionTitleStyle}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="内存" Style="{StaticResource FograinKeyTextStyle}" VerticalAlignment="Center" />
                        <ComboBox
                            x:Name="MemoryComboBox"
                            Grid.Column="1"
                            Width="140"
                            HorizontalAlignment="Left"
                            SelectionChanged="MemoryComboBox_SelectionChanged" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="JVM 参数" Style="{StaticResource FograinKeyTextStyle}" VerticalAlignment="Center" />
                        <TextBox
                            x:Name="JvmBox"
                            Grid.Column="1"
                            MaxWidth="320"
                            HorizontalAlignment="Left"
                            PlaceholderText="追加到启动命令的自定义参数"
                            LostFocus="JvmBox_LostFocus"
                            KeyDown="JvmBox_KeyDown" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Java 运行时" Style="{StaticResource FograinKeyTextStyle}" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="JavaRuntimeText"
                            Grid.Column="1"
                            Style="{StaticResource FograinValueTextStyle}"
                            VerticalAlignment="Center" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="启动行为" Style="{StaticResource FograinKeyTextStyle}" VerticalAlignment="Center" />
                        <ToggleSwitch
                            x:Name="FullscreenToggle"
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            OnContent="启动时全屏"
                            OffContent="启动时全屏"
                            Toggled="FullscreenToggle_Toggled" />
                    </Grid>
                </StackPanel>

                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- 显示 -->
                <StackPanel Spacing="10">
                    <TextBlock Text="显示" Style="{StaticResource FograinSectionTitleStyle}" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="窗口分辨率" Style="{StaticResource FograinKeyTextStyle}" VerticalAlignment="Center" />
                        <ComboBox
                            x:Name="ResolutionComboBox"
                            Grid.Column="1"
                            Width="200"
                            HorizontalAlignment="Left"
                            SelectionChanged="ResolutionComboBox_SelectionChanged" />
                    </Grid>
                    <TextBlock
                        Text="分辨率留空或选择「跟随游戏默认」时继承全局设置。"
                        Style="{StaticResource FograinTinyTextStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- 内容: owned by M8/M9, shown disabled so the structure matches. -->
                <StackPanel Spacing="8">
                    <TextBlock Text="内容" Style="{StaticResource FograinSectionTitleStyle}" />
                    <ItemsControl x:Name="ContentMilestones">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:MilestoneRow">
                                <Grid Height="30" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="{x:Bind Title}"
                                        FontSize="12"
                                        VerticalAlignment="Center" />
                                    <Border
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Padding="8,2"
                                        CornerRadius="8"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock
                                            Text="{x:Bind Milestone}"
                                            FontSize="10"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- 维护 -->
                <StackPanel Spacing="8">
                    <TextBlock Text="维护" Style="{StaticResource FograinSectionTitleStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Style="{StaticResource FograinSmallButtonStyle}"
                            Click="OpenFolder_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Viewbox Width="12" Height="12">
                                    <SymbolIcon Symbol="Folder" />
                                </Viewbox>
                                <TextBlock Text="打开实例目录" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button
                            Style="{StaticResource FograinSmallButtonStyle}"
                            Click="Delete_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Viewbox Width="12" Height="12">
                                    <SymbolIcon Symbol="Delete" />
                                </Viewbox>
                                <TextBlock Text="删除实例…" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid
            x:Name="LoadingOverlay"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            Opacity="0.9"
            Visibility="Collapsed">
            <ProgressRing
                x:Name="LoadingRing"
                Width="24"
                Height="24"
                IsActive="True"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>
    </Grid>
</ContentDialog>
