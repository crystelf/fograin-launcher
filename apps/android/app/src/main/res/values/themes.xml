<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose owns the real surface; this theme only covers the starting window
      and the pre-Compose frame. Colors come from design/tokens.json through the
      generated colors.xml files, including values-night.
    -->
    <style name="Theme.Fograin" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/fograin_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
