<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Fograin.Windows.Features.Downloads.GameInstallDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Fograin.Windows.Models"
    mc:Ignorable="d"
    Title="安装游戏"
    PrimaryButtonText="安装"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">620</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">680</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="540" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" MinWidth="540">
            <TextBlock
                Text="选择加载器与版本，然后下载。内存与显示选项在下载完成后的「游戏设置」里调整。"
                Style="{StaticResource FograinMutedTextStyle}"
                TextWrapping="Wrap" />

            <StackPanel Spacing="6">
                <TextBlock Text="游戏版本" Style="{StaticResource FograinKeyTextStyle}" />
                <ComboBox
                    x:Name="GameVersionComboBox"
                    Width="220"
                    HorizontalAlignment="Left"
                    SelectionChanged="GameVersionComboBox_SelectionChanged" />
            </StackPanel>

            <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="加载器"
                        Style="{StaticResource FograinSectionTitleStyle}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="1"
                        Text="原版可直接安装；其余为 M5 预留位"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource FograinTinyTextStyle}" />
                </Grid>

                <GridView
                    x:Name="LoaderGrid"
                    Height="336"
                    SelectionMode="Single"
                    IsItemClickEnabled="False"
                    SelectionChanged="LoaderGrid_SelectionChanged">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid
                                Orientation="Vertical"
                                MaximumRowsOrColumns="2"
                                ItemWidth="248"
                                ItemHeight="70" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:GameLoaderOption">
                            <Border
                                Padding="12,10"
                                CornerRadius="8"
                                BorderThickness="1"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Viewbox Width="16" Height="16" VerticalAlignment="Top">
                                        <SymbolIcon
                                            Symbol="{x:Bind Icon}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Viewbox>

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock
                                                Text="{x:Bind Title}"
                                                FontSize="13"
                                                FontWeight="SemiBold" />
                                            <TextBlock
                                                Text="{x:Bind MilestoneText}"
                                                FontSize="9"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock
                                            Text="{x:Bind Subtitle}"
                                            FontSize="11"
                                            TextWrapping="Wrap"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>

            <StackPanel x:Name="LoaderVersionPanel" Spacing="6" Visibility="Collapsed">
                <TextBlock x:Name="LoaderVersionLabel" Text="加载器版本" Style="{StaticResource FograinKeyTextStyle}" />
                <ComboBox
                    x:Name="LoaderVersionComboBox"
                    Width="220"
                    HorizontalAlignment="Left" />
                <TextBlock
                    x:Name="LoaderVersionHint"
                    Style="{StaticResource FograinTinyTextStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="实例名称" Style="{StaticResource FograinKeyTextStyle}" />
                <TextBox
                    x:Name="InstanceNameBox"
                    MaxWidth="320"
                    HorizontalAlignment="Left"
                    PlaceholderText="留空时使用版本号" />
                <TextBlock
                    Text="留空时使用版本号。内存、JVM 参数与显示选项在下载完成后的「游戏设置」里调整。"
                    Style="{StaticResource FograinTinyTextStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar
                x:Name="ErrorBar"
                IsOpen="False"
                IsClosable="False"
                Severity="Error" />

            <TextBlock
                x:Name="FooterText"
                Style="{StaticResource FograinTinyTextStyle}"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
