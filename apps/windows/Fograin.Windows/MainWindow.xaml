<Window
    x:Class="Fograin.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="雾雨启动器">

    <NavigationView
        x:Name="RootNavigation"
        PaneDisplayMode="Left"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        Header="主页">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="主页" Tag="home">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="实例库" Tag="library">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="AllApps" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="服务器" Tag="servers">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Globe" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItemSeparator />
            <NavigationViewItem Content="下载" Tag="downloads">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Download" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Java 运行时" Tag="java">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Setting" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="账户" Tag="accounts">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Contact" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid Padding="28">
            <StackPanel Spacing="8">
                <TextBlock Text="原生 WinUI 3 外壳已就绪" FontSize="28" FontWeight="SemiBold" />
                <TextBlock
                    Text="这一页之后会换成原生主页布局；不再使用 WebView 或 CSS 皮肤。"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </NavigationView>
</Window>
