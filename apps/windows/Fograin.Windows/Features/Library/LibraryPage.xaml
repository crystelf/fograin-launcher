<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fograin.Windows.Features.Library.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Fograin.Windows.Models"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header: sort order replaces the macOS toolbar menu. -->
        <Grid Height="56">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Bottom" Spacing="2">
                <TextBlock Text="实例库" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="{x:Bind Model.LibrarySubtitle, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Bottom">
                <Button
                    Style="{StaticResource AccentButtonStyle}"
                    Height="32"
                    Padding="12,0"
                    FontSize="13"
                    Click="AddInstance_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Viewbox Width="14" Height="14">
                            <SymbolIcon
                                Symbol="Add"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Viewbox>
                        <TextBlock
                            Text="添加实例"
                            FontSize="13"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </StackPanel>
                </Button>
                <Button
                    Style="{StaticResource FograinCommandButtonStyle}"
                    Click="ImportDirectory_Click"
                    ToolTipService.ToolTip="登记一个已有的 .minecraft 目录">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Viewbox Width="14" Height="14">
                            <SymbolIcon Symbol="Upload" />
                        </Viewbox>
                        <TextBlock Text="导入 .minecraft" FontSize="13" />
                    </StackPanel>
                </Button>
                <ComboBox
                    x:Name="SortComboBox"
                    Width="132"
                    Height="32"
                    SelectedIndex="0"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="排序方式"
                    SelectionChanged="SortComboBox_SelectionChanged">
                    <ComboBoxItem Content="上次游玩" />
                    <ComboBoxItem Content="名称" />
                    <ComboBoxItem Content="占用空间" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Grouped instance table (native ListView grouping by loader). -->
            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Height="26" Padding="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="1"
                        Text="名称"
                        FontSize="11"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock
                        Grid.Column="2"
                        Text="游戏版本"
                        FontSize="11"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock
                        Grid.Column="3"
                        Text="模组"
                        FontSize="11"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock
                        Grid.Column="4"
                        Text="大小"
                        FontSize="11"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock
                        Grid.Column="5"
                        Text="上次游玩"
                        FontSize="11"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </Grid>

                <ListView
                    x:Name="LibraryList"
                    Grid.Row="1"
                    SelectionMode="Single"
                    ItemContainerStyle="{StaticResource FograinLibraryRowStyle}"
                    SelectionChanged="LibraryList_SelectionChanged"
                    DoubleTapped="LibraryList_DoubleTapped">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:InstanceRow">
                            <Grid Height="44" Padding="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="28" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Width="28"
                                    Height="28"
                                    CornerRadius="4"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <Viewbox Width="14" Height="14">
                                        <SymbolIcon
                                            Symbol="{x:Bind Icon}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Viewbox>
                                </Border>

                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <FontIcon
                                        Glyph="&#xE735;"
                                        FontSize="9"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind FavoriteVisibility}"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="{x:Bind Minecraft}"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    Grid.Column="3"
                                    Text="{x:Bind ModsText}"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    Grid.Column="4"
                                    Text="{x:Bind SizeText}"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    Grid.Column="5"
                                    Text="{x:Bind LastPlayedText}"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <Button
                                    Grid.Column="6"
                                    Style="{StaticResource FograinIconButtonStyle}"
                                    Width="28"
                                    Height="28"
                                    ToolTipService.ToolTip="更多操作">
                                    <SymbolIcon Symbol="More" />
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                Text="开始游戏"
                                                Tag="{x:Bind Id}"
                                                Click="RowPlay_Click" />
                                            <MenuFlyoutItem
                                                Text="管理实例…"
                                                Tag="{x:Bind Id}"
                                                Click="RowManage_Click" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem
                                                Text="打开实例文件夹"
                                                Tag="{x:Bind Id}"
                                                Click="RowOpenFolder_Click" />
                                            <MenuFlyoutItem
                                                Text="{x:Bind FavoriteActionText}"
                                                Tag="{x:Bind Id}"
                                                Click="RowToggleFavorite_Click" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="models:InstanceGroup">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Height="28"
                                        Padding="12,4">
                                        <FontIcon
                                            Glyph="&#xE70D;"
                                            FontSize="12"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock
                                            Text="{x:Bind Title}"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Center" />
                                        <Border
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="8"
                                            Height="16"
                                            Padding="6,0"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{x:Bind TotalText}"
                                                FontSize="10"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                </ListView>

                <!-- Empty / filtered-out state. -->
                <StackPanel
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="{x:Bind Model.LibraryEmptyVisibility, Mode=OneWay}">
                    <TextBlock
                        Text="没有匹配的实例"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="试试其他关键字，或添加第一个实例。"
                        Style="{StaticResource FograinMutedTextStyle}"
                        HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,6,0,0">
                        <Button Content="清除搜索" Style="{StaticResource FograinCommandButtonStyle}" Click="ClearSearch_Click" />
                        <Button Content="添加实例" Style="{StaticResource AccentButtonStyle}" Height="32" Padding="14,0" Click="AddInstance_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Inspector column: selection drives the preview. -->
            <Grid Grid.Column="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14" Visibility="{x:Bind Model.PreviewVisibility, Mode=OneWay}">
                        <Border Height="140" CornerRadius="10">
                            <Grid>
                                <Image Source="ms-appx:///Assets/hero-forest.jpg" Stretch="UniformToFill" />
                                <Border Background="{StaticResource FograinHeroScrimBrush}" />
                                <StackPanel
                                    VerticalAlignment="Bottom"
                                    Padding="14,0,14,12"
                                    Spacing="2">
                                    <TextBlock
                                        Text="{x:Bind Model.SelectedName, Mode=OneWay}"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind Model.SelectedSubtitle, Mode=OneWay}"
                                        FontSize="11"
                                        Foreground="#CCFFFFFF"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button
                                Style="{StaticResource AccentButtonStyle}"
                                Height="32"
                                Padding="14,0"
                                IsEnabled="{x:Bind Model.HasSelectedInstance, Mode=OneWay}"
                                Click="PreviewPlay_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Viewbox Width="13" Height="13">
                                        <SymbolIcon
                                            Symbol="Play"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Viewbox>
                                    <TextBlock
                                        Text="开始游戏"
                                        FontSize="13"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Button>
                            <Button
                                Style="{StaticResource FograinIconButtonStyle}"
                                Width="32"
                                Height="32"
                                IsEnabled="{x:Bind Model.HasSelectedInstance, Mode=OneWay}"
                                Click="PreviewManage_Click"
                                ToolTipService.ToolTip="管理实例">
                                <Viewbox Width="14" Height="14">
                                    <SymbolIcon Symbol="Setting" />
                                </Viewbox>
                            </Button>
                            <Button
                                Style="{StaticResource FograinIconButtonStyle}"
                                Width="32"
                                Height="32"
                                IsEnabled="{x:Bind Model.HasSelectedInstance, Mode=OneWay}"
                                Click="PreviewFolder_Click"
                                ToolTipService.ToolTip="打开实例文件夹">
                                <Viewbox Width="14" Height="14">
                                    <SymbolIcon Symbol="Folder" />
                                </Viewbox>
                            </Button>
                            <Button
                                Style="{StaticResource FograinIconButtonStyle}"
                                Width="32"
                                Height="32"
                                IsEnabled="{x:Bind Model.HasSelectedInstance, Mode=OneWay}"
                                Click="PreviewFavorite_Click"
                                ToolTipService.ToolTip="收藏 / 取消收藏"
                                Opacity="{x:Bind Model.SelectedFavoriteOpacity, Mode=OneWay}">
                                <FontIcon Glyph="&#xE735;" FontSize="14" />
                            </Button>
                        </StackPanel>

                        <TextBlock
                            Text="双击列表项进入实例管理"
                            Style="{StaticResource FograinTinyTextStyle}" />

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <Grid ColumnSpacing="10" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="游戏版本" Style="{StaticResource FograinKeyTextStyle}" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind Model.SelectedMinecraftText, Mode=OneWay}"
                                Style="{StaticResource FograinValueTextStyle}"
                                TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Row="1" Text="加载器" Style="{StaticResource FograinKeyTextStyle}" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{x:Bind Model.SelectedLoaderText, Mode=OneWay}"
                                Style="{StaticResource FograinValueTextStyle}"
                                TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Row="2" Text="模组" Style="{StaticResource FograinKeyTextStyle}" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Text="{x:Bind Model.SelectedModsText, Mode=OneWay}"
                                Style="{StaticResource FograinValueTextStyle}" />

                            <TextBlock Grid.Row="3" Text="内存" Style="{StaticResource FograinKeyTextStyle}" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                Text="{x:Bind Model.MemorySummary, Mode=OneWay}"
                                Style="{StaticResource FograinValueTextStyle}"
                                TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Row="4" Text="占用空间" Style="{StaticResource FograinKeyTextStyle}" />
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="1"
                                Text="{x:Bind Model.SelectedSizeText, Mode=OneWay}"
                                Style="{StaticResource FograinValueTextStyle}" />

                            <TextBlock Grid.Row="5" Text="游玩时长" Style="{StaticResource FograinKeyTextStyle}" />
                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="1"
                                Text="{x:Bind Model.SelectedPlayTimeText, Mode=OneWay}"
                                Style="{StaticResource FograinValueTextStyle}" />

                            <TextBlock Grid.Row="6" Text="上次游玩" Style="{StaticResource FograinKeyTextStyle}" />
                            <TextBlock
                                Grid.Row="6"
                                Grid.Column="1"
                                Text="{x:Bind Model.SelectedLastPlayedText, Mode=OneWay}"
                                Style="{StaticResource FograinValueTextStyle}" />
                        </Grid>

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Spacing="6">
                            <TextBlock Text="状态" Style="{StaticResource FograinKeyTextStyle}" />
                            <TextBlock
                                Text="{x:Bind Model.SelectedStatusText, Mode=OneWay}"
                                Style="{StaticResource FograinValueTextStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="{x:Bind Model.NoPreviewVisibility, Mode=OneWay}">
                    <TextBlock
                        Text="未选择实例"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="在左侧列表中选择一个实例查看详情。"
                        Style="{StaticResource FograinMutedTextStyle}"
                        HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid
            Grid.RowSpan="2"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            Opacity="0.92"
            Visibility="{x:Bind Model.LoadingVisibility, Mode=OneWay}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressRing Width="24" Height="24" IsActive="True" />
                <TextBlock Text="正在读取实例…" Style="{StaticResource FograinMutedTextStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
