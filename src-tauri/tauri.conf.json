{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fograin",
  "version": "0.1.0",
  "identifier": "com.fograin.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Minecraft Java Edition launcher",
    "longDescription": "Fograin Launcher (雾雨启动器) is a Minecraft Java Edition launcher for macOS, Windows and Linux.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
